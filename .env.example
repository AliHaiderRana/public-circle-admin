# Public Circle main database
MONGODB_URI=

# Referral-app database (sales/marketing partner login).
# Set to the same value as MONGODB_URL in referral-app/BE/.env
REFERRAL_APP_MONGODB_URL=

JWT_SECRET=
NODE_ENV=development

# Shared secret for referral-app → admin partner SSO handoff.
# Must match PARTNER_PORTAL_SSO_SECRET in referral-app/BE/.env
PARTNER_PORTAL_SSO_SECRET=

# Public Circle server (internal provision API)
API_BASE_URL=http://localhost:3001
INTERNAL_API_KEY=internal_admin_cron_key_2024
