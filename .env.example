# Public Circle main database
MONGODB_URI=

# Referral-app database (partner login + partner portal integration settings).
REFERRAL_APP_MONGODB_URL=

# Public Circle server only — must match referral-app BE ACCESS_TOKEN_SECRET for partner realtime sockets.
REFERRAL_APP_ACCESS_TOKEN_SECRET=

# Admin dev server (custom server.ts hosts /partner-realtime on this port)
# PORT=3000

JWT_SECRET=
NODE_ENV=development

# Integrations admin UI (partner portal / server URL settings). Off in prod until ready.
NEXT_PUBLIC_ADMIN_INTEGRATIONS_ENABLED=false

# Bootstrap only — server URL and internal API key are managed in admin → Integrations.
# Optional defaults for integration docs preview on the Integrations page:
# REFERRAL_APP_WEB_URL=http://localhost:3030
# REFERRAL_APP_API_URL=http://localhost:4000/api/v1
# Shared secret for referral API → admin internal routes (auto-generated on admin Integrations save):
# REFERRAL_BACKEND_API_KEY=
